<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:LanLink"
             xmlns:core="clr-namespace:LanLink;assembly=LanLink.Core"
             x:Class="LanLink.MainPage"
             Title="LanLink"
             Shell.NavBarIsVisible="True">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" Padding="0">
            <Label Text="LanLink" FontSize="20" FontAttributes="Bold"
                   VerticalOptions="Center" TextColor="White"/>
            <ImageButton Grid.Column="1" Source="gear.png"
                         WidthRequest="28" HeightRequest="28"
                         VerticalOptions="Center" Margin="0,0,8,0"
                         Clicked="Settings_Clicked"
                         BackgroundColor="Transparent"/>
        </Grid>
    </Shell.TitleView>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="12" RowSpacing="10"
          BackgroundColor="#F3F4F6">

        <!-- ============ ROW 0: PEER LIST ============ -->
        <Border x:Name="PeersFrame"
               Grid.Row="0"
               Padding="10"
               BackgroundColor="White"
               Stroke="#E5E7EB"
               StrokeThickness="1"
               StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="6">
                <Label Text="Peers" FontSize="15" FontAttributes="Bold"/>

                <CollectionView x:Name="PeerListView"
                                SelectionMode="Single"
                                SelectionChanged="PeerList_SelectionChanged"
                                HeightRequest="120">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="core:Peer">
                            <!--
                                The selection highlight lives on the SwipeView
                                because that is the DataTemplate's root element,
                                and CollectionView drives the Selected visual
                                state on the root only.  The inner Grid must stay
                                Transparent: hardcoding White there is what used
                                to paint over the highlight, so tapping a peer
                                looked like it did nothing at all.
                            -->
                            <SwipeView BackgroundColor="White">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroupList>
                                        <VisualStateGroup x:Name="CommonStates">
                                            <VisualState x:Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="White"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState x:Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#DBEAFE"/>
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateGroupList>
                                </VisualStateManager.VisualStateGroups>

                                <SwipeView.RightItems>
                                    <SwipeItems>
                                        <SwipeItem Text="Remove"
                                                   BackgroundColor="#DC2626"
                                                   Invoked="RemovePeer_Invoked"
                                                   CommandParameter="{Binding .}"
                                                   IsVisible="{Binding IsConnected, Converter={StaticResource InvertBoolConverter}}"/>
                                    </SwipeItems>
                                </SwipeView.RightItems>

                                <Grid ColumnDefinitions="Auto,*,Auto" Padding="4,6" ColumnSpacing="8"
                                      BackgroundColor="Transparent">
                                    <Ellipse Grid.Column="0" WidthRequest="10" HeightRequest="10"
                                             VerticalOptions="Center"
                                             Fill="{Binding IsConnected, Converter={StaticResource BoolToColorConverter}}"/>
                                    <Label Grid.Column="1" Text="{Binding Name}"
                                           FontSize="14" VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{Binding IsConnected, Converter={StaticResource ConnectedToTextColorConverter}}"/>
                                    <Label Grid.Column="2"
                                           Text="{Binding StatusLabel}"
                                           FontSize="11" TextColor="#9CA3AF"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </SwipeView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label x:Name="PeerEmptyLabel"
                               Text="Starting..."
                               TextColor="#9CA3AF" FontSize="13"
                               HorizontalOptions="Center" Margin="0,10"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </VerticalStackLayout>
        </Border>

        <!-- ============ ROW 1: CONNECT REMOTE ============ -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <Entry x:Name="RemoteEntry" Placeholder="Remote host or host:port"
                   FontSize="13" BackgroundColor="White"
                   ReturnCommand="{x:Null}" Completed="RemoteEntry_Completed"/>
            <Button Grid.Column="1" Text="Connect" FontSize="13"
                    Padding="14,0" Clicked="ConnectRemote_Clicked"
                    Style="{StaticResource PrimaryButton}"/>
        </Grid>

        <!-- ============ ROW 2: ACTIVITY LOG ============ -->
        <Border Grid.Row="2"
               Padding="10"
               BackgroundColor="White"
               Stroke="#E5E7EB"
               StrokeThickness="1"
               StrokeShape="RoundRectangle 10">
            <!--
                Grid, NOT VerticalStackLayout.  A stack layout measures its
                children with infinite height, so the CollectionView sized itself
                to its entire content, overflowed the Border and was clipped: it
                scrolled by the few pixels of slack and no further, hiding every
                new entry (including transfer progress) below the fold.  Giving it
                a `*` row bounds its height so it scrolls internally, which is
                also what makes ItemsUpdatingScrollMode="KeepLastItemInView" work.
            -->
            <Grid RowDefinitions="Auto,*" RowSpacing="4">
                <Label Grid.Row="0" Text="Activity" FontSize="15" FontAttributes="Bold"/>
                <CollectionView Grid.Row="1" x:Name="ActivityLogView"
                                ItemsUpdatingScrollMode="KeepLastItemInView">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="core:LogEntry">
                            <Label local:LinkBehavior.FormattedText="{Binding Display}"
                                   local:LinkBehavior.TextColor="{Binding Level, Converter={StaticResource LevelToColorConverter}}"
                                   FontSize="12"
                                   LineBreakMode="WordWrap" Padding="0,2">
                                <FlyoutBase.ContextFlyout>
                                    <MenuFlyout>
                                        <MenuFlyoutItem Text="Copy"
                                                        Clicked="CopyMessage_Clicked"
                                                        CommandParameter="{Binding .}"/>
                                    </MenuFlyout>
                                </FlyoutBase.ContextFlyout>
                            </Label>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </Border>

        <!-- ============ ROW 3: SEND CONTROLS ============ -->
        <Border Grid.Row="3"
               Padding="10"
               BackgroundColor="White"
               Stroke="#E5E7EB"
               StrokeThickness="1"
               StrokeShape="RoundRectangle 10">
            <VerticalStackLayout Spacing="8">

                <!-- Stays outside the blocker so the instruction is never washed out. -->
                <Label x:Name="SendToLabel" Text="Select a peer above to send to"
                       FontSize="14" FontAttributes="Bold" TextColor="#B45309"/>

                <Grid>
                    <VerticalStackLayout Spacing="8">

                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <Entry x:Name="MessageEntry" Placeholder="Message..."
                                   IsEnabled="False"
                                   Style="{StaticResource SendEntry}"
                                   ReturnCommand="{x:Null}" Completed="MessageEntry_Completed"/>
                            <Button x:Name="SendTextBtn" Grid.Column="1"
                                    Text="Send" Padding="16,0" IsEnabled="False"
                                    Clicked="SendText_Clicked"
                                    Style="{StaticResource PrimaryButton}"/>
                        </Grid>

                        <!-- File/folder sending needs a live connection, so it has
                             its own blocker for the "peer selected but offline" case. -->
                        <Grid>
                            <VerticalStackLayout Spacing="8">
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button x:Name="SendFilesBtn" Text="Send Files"
                                            IsEnabled="False" Clicked="SendFiles_Clicked"
                                            Style="{StaticResource AccentButton}"/>
                                    <Button x:Name="SendFolderBtn" Grid.Column="1"
                                            Text="Send Folder"
                                            IsEnabled="False" Clicked="SendFolder_Clicked"
                                            Style="{StaticResource AccentButton}"/>
                                </Grid>
                                <Button x:Name="SendViaAppsBtn"
                                        Text="Pick from other apps (Drive, etc.)"
                                        IsEnabled="False" Clicked="SendViaApps_Clicked"
                                        Style="{StaticResource SubtleButton}"/>
                            </VerticalStackLayout>

                            <Grid x:Name="OfflineBlocker" BackgroundColor="#59FFFFFF"
                                  IsVisible="False">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OfflineBlocker_Tapped"/>
                                </Grid.GestureRecognizers>
                            </Grid>
                        </Grid>

                    </VerticalStackLayout>

                    <!-- Transparent controls swallow taps silently, which is exactly
                         how "I tapped the text field and nothing happened" happens.
                         This catches the tap and explains instead. -->
                    <Grid x:Name="NoPeerBlocker" BackgroundColor="#59FFFFFF">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="NoPeerBlocker_Tapped"/>
                        </Grid.GestureRecognizers>
                    </Grid>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
