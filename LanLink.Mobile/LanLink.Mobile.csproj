<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net9.0-android</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <RootNamespace>LanLink</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <ApplicationTitle>LanLink</ApplicationTitle>
    <ApplicationId>com.lanlink.mobile</ApplicationId>
    <ApplicationDisplayVersion>1.2.2.0</ApplicationDisplayVersion>
    <ApplicationVersion>1020200</ApplicationVersion>
    <SupportedOSPlatformVersion>21</SupportedOSPlatformVersion>

    <!-- Without this, $(AndroidManifest) evaluates to empty and the .NET Android
         build synthesises the manifest purely from [assembly: UsesPermission]
         attributes; Platforms\Android\AndroidManifest.xml is never read at all.
         That silently dropped both storage permissions, usesCleartextTraffic and
         the icon attributes, while the file sat there looking authoritative.
         Permissions declared as assembly attributes are merged into this file,
         so both sources still work; the file is the primary one. -->
    <AndroidManifest>Platforms\Android\AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="9.0.111" />
    <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <MauiIcon Include="Resources\AppIcon\appicon.svg" Color="#1D4ED8" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#1E40AF" BaseSize="128,128" />
  </ItemGroup>
</Project>
