<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <!-- These are normally supplied by build-msi.bat via -d; defaults let the
       file build on its own for quick validation. -->
  <?ifndef Version?>    <?define Version    = "1.0.0.0"?>            <?endif?>
  <?ifndef PublishDir?> <?define PublishDir = "publish"?>           <?endif?>

  <Package Name="LanLink"
           Manufacturer="LanLink"
           Version="$(var.Version)"
           UpgradeCode="7E3C1A02-6B4D-4E8F-9C21-4A5B6C7D8E90"
           Scope="perMachine"
           Compressed="yes">

    <SummaryInformation Description="LanLink — LAN file and text sharing"
                        Keywords="LanLink, LAN, file transfer, installer" />

    <!-- Windows uses ProductVersion + UpgradeCode to recognise a newer build
         and remove the older one automatically. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  DowngradeErrorMessage="A newer version of LanLink is already installed. Setup will now exit." />

    <MediaTemplate EmbedCab="yes" />

    <!-- Icon for Add/Remove Programs and the Start Menu shortcut.  Point at the
         small standalone .ico (resolved via the LanLink project bind path passed
         to `wix build`), NOT at LanLink.exe — sourcing it from the 71 MB exe made
         the MSI embed the whole binary a second time, doubling its size. -->
    <Icon Id="LanLinkIcon" SourceFile="LanLink.ico" />
    <Property Id="ARPPRODUCTICON" Value="LanLinkIcon" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <!-- Autostart-on-boot choice.  Default checked; the setup checkbox toggles it. -->
    <Property Id="AUTOSTART" Value="1" Secure="yes" />

    <!-- Default install location:
           x64 package  -> C:\Program Files\LanLink
           x86 package  -> C:\Program Files (x86)\LanLink -->
    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="LanLink" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- Remember where a previous version was installed.  On upgrade this
         RegistrySearch (run during AppSearch, before the UI and before the
         StopRunningLanLink custom action) overrides INSTALLFOLDER with the
         old path, so a custom install location is honored and the "exit the
         running app" action targets the correct exe.  If the value is absent
         (fresh install, or upgrading from a build that predates this key),
         INSTALLFOLDER keeps its default of ProgramFiles6432\LanLink. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallDir"
                      Root="HKLM" Key="SOFTWARE\LanLink"
                      Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="LanLink" Level="1">
      <ComponentGroupRef Id="AppComponents" />
    </Feature>

    <!-- Before an upgrade replaces the exe, tell any running LanLink to exit
         (IPC) and wait for it to release the file.  Skipped on first install
         (no previous copy present). -->
    <CustomAction Id="StopRunningLanLink"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]LanLink.exe&quot; --exit"
                  Execute="immediate"
                  Return="ignore"
                  Impersonate="yes" />

    <!-- "Launch LanLink now" on the final wizard page.  Without this the
         installer had no way to start the app at all: the only checkbox in
         setup is the autostart-on-boot one, which writes a registry request
         and takes effect at the *next sign-in*, so after installing, nothing
         was listening and peers showed the machine greyed out until it was
         launched by hand.

         Impersonate="yes" so it runs as the installing user rather than the
         elevated MSI account (LanLink's autostart and settings are per-user).
         Return="asyncNoWait" so setup closes immediately instead of waiting
         for the app to exit. -->
    <CustomAction Id="LaunchLanLink"
                  Directory="INSTALLFOLDER"
                  ExeCommand="&quot;[INSTALLFOLDER]LanLink.exe&quot;"
                  Execute="immediate"
                  Return="asyncNoWait"
                  Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="StopRunningLanLink" Before="InstallValidate"
              Condition="WIX_UPGRADE_DETECTED" />
    </InstallExecuteSequence>

    <!-- UI: welcome -> license -> install dir -> autostart choice -> ready. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Turns the stock ExitDialog's optional checkbox into "Launch LanLink
         now", ticked by default. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch LanLink now" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />

    <UI>
      <!-- Insert the custom "Autostart" dialog between the install-dir dialog
           and the ready-to-install dialog.  Higher Order than the stock
           navigation so our NewDialog wins. -->
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="AutostartDlg"
               Order="10" Condition="WIXUI_INSTALLDIR_VALID = &quot;1&quot;" />
      <Publish Dialog="AutostartDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg"
               Order="10" />
      <Publish Dialog="AutostartDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg"
               Order="10" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="AutostartDlg"
               Order="10" Condition="NOT Installed" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchLanLink"
               Order="10" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1" />
    </UI>
  </Package>

  <!-- ===================================================================== -->
  <!--  Installed payload                                                     -->
  <!-- ===================================================================== -->
  <Fragment>
    <ComponentGroup Id="AppComponents">

      <!-- The self-contained single-file executable. -->
      <Component Id="MainExecutable" Directory="INSTALLFOLDER" Guid="*">
        <File Id="LanLinkExe" Source="$(var.PublishDir)\LanLink.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut"
                    Directory="ProgramMenuFolder"
                    Name="LanLink"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="LanLinkIcon"
                    Advertise="yes" />
        </File>
      </Component>

      <!-- Persist the chosen install location so a later upgrade can find it
           (read back by the PreviousInstallDir RegistrySearch above). -->
      <Component Id="RememberInstallDir" Directory="INSTALLFOLDER"
                 Guid="4B2E9A17-8C6D-4F03-9A1E-7D5C2B0F6A38">
        <RegistryValue Root="HKLM" Key="SOFTWARE\LanLink"
                       Name="InstallDir" Type="string"
                       Value="[INSTALLFOLDER]" KeyPath="yes" />
      </Component>

      <!-- Autostart *request* — setup's answer to the autostart checkbox.

           Deliberately not a Run entry.  Windows launches an app once per Run
           entry, each carrying its own start-mode flag, so a machine-wide entry
           here plus the per-user one LanLink manages meant two launches racing
           to decide how the app appears: setup's mode could silently override
           the one chosen in Settings, and turning autostart off looked like a
           no-op.  Removing an HKLM entry also needs elevation the app doesn't
           have.  So the per-user (HKCU) entry is the single source of truth and
           only LanLink writes it.

           The value is "<version>|<1 if ticked>": setup's answer, stamped with
           the version so each install is applied exactly once.  On first run
           LanLink compares it with the stamp it last handled, turns it into the
           real HKCU entry (creating or removing it), and thereafter leaves the
           user's choice alone.  Both answers are recorded — writing the value
           unconditionally rather than only when ticked is what lets *unticking*
           the box turn an existing autostart off.

           It lives in HKLM because a per-machine MSI's execute sequence runs as
           SYSTEM — an HKCU write would land in SYSTEM's hive, not the user's.

           Note the component GUID differs from the pre-1.0.4.0 Run-entry
           component's, so upgrading removes that stale machine-wide entry. -->
      <Component Id="AutostartRequest" Directory="INSTALLFOLDER"
                 Guid="2A7D9E44-1F63-4B58-8E0A-3C5D9B1746E2">
        <RegistryValue Root="HKLM" Key="SOFTWARE\LanLink"
                       Name="AutostartRequest" Type="string"
                       Value="$(var.Version)|[AUTOSTART]" KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ===================================================================== -->
  <!--  Custom "Autostart" wizard page                                        -->
  <!-- ===================================================================== -->
  <Fragment>
    <UI>
      <Dialog Id="AutostartDlg" Width="370" Height="270" Title="[ProductName] Setup">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44"
                 TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="280" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="{\WixUI_Font_Title}Startup options" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes"
                 NoPrefix="yes" Text="Choose whether LanLink starts automatically." />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />

        <Control Id="AutostartCheckBox" Type="CheckBox" X="20" Y="80" Width="330" Height="18"
                 Property="AUTOSTART" CheckBoxValue="1"
                 Text="Start LanLink automatically when Windows starts (minimized to the tray)" />
        <Control Id="AutostartHint" Type="Text" X="36" Y="102" Width="314" Height="30" Transparent="yes"
                 NoPrefix="yes"
                 Text="You can change this later in LanLink's Settings window." />

        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17"
                 Text="!(loc.WixUIBack)" />
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes"
                 Text="!(loc.WixUINext)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes"
                 Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>
  </Fragment>

</Wix>
